# Copy to .env for local development. NEVER commit a real .env or real secrets.

NODE_ENV=development
PORT=4000

# First-run admin bootstrap (used only to seed the first Super Admin).
# ADMIN_PASSWORD must be at least 12 characters, with a letter and a number.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Data + upload directories (a persistent disk in production).
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Public base URL, used to build password-reset links in emails.
APP_BASE_URL=http://localhost:4000

# Outbound email for password-reset links (optional).
# If SMTP is not configured, no email is sent and the reset link is written to
# the CMS "email outbox" so an operator can deliver it manually.
# Provide real values only via your host's secret manager — never in git.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MSME Catalyst <no-reply@msmecatalyst.org>

# Test-only: enables the /api/auth/forgot devToken response for the test suite.
# MUST remain unset in production.
# ALLOW_TEST_HOOKS=1
